App(
    appid="subghz",
    name="Sub-GHz",
    apptype=FlipperAppType.APP,
    targets=["f7"],
    cdefines=["APP_SUBGHZ"],
    entry_point="subghz_app",
    requires=[
        "gui",
        "cli",
        "dialogs",
    ],
    provides=[
        "subghz_load_dangerous_settings",
    ],
    icon="A_Sub1ghz_14",
    stack_size=3 * 1024,
    order=1,
    resources="resources",
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
)

# External full-featured variant. It intentionally shares the system Sub-GHz
# sources so functional parity cannot drift while it is validated as the future
# Desktop replacement.
App(
    appid="arf_subghz_full",
    name="ARF Sub-GHz Full",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    cdefines=["APP_SUBGHZ", "ARF_EXTERNAL_FULL"],
    entry_point="subghz_app",
    sources=[
        "subghz.c",
        "subghz_i.c",
        "subghz_last_settings.c",
        "subghz_history.c",
        "helpers/*.c",
        "!helpers/subghz_chat.c",
        "scenes/*.c",
        "views/*.c",
    ],
    requires=[
        "gui",
        "dialogs",
        "subghz_radio_broker",
    ],
    icon="A_Sub1ghz_14",
    stack_size=3 * 1024,
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="ARF Tools",
)

App(
    appid="cli_subghz",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_subghz_ep",
    requires=["cli"],
    sources=["subghz_cli.c", "helpers/subghz_chat.c"],
)

App(
    appid="subghz_load_dangerous_settings",
    apptype=FlipperAppType.STARTUP,
    entry_point="subghz_dangerous_freq",
    requires=["storage", "subghz"],
    order=650,
)

App(
    appid="desktop_settings",
    name="Desktop",
    apptype=FlipperAppType.EXTSETTINGS,
    entry_point="desktop_settings_app",
    requires=[
        "desktop",
        "gui",
    ],
    # Profile verification peaks at 1224 + 432 bytes before storage/API callers.
    stack_size=3 * 1024,
    order=40,
    fap_libs=["assets"],
    fap_category="assets",
)

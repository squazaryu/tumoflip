{
    "$schema": "https://typedoc.org/schema.json",
    "name": "Tumoflip JavaScript API",
    "excludePrivate": true,
    "entryPointStrategy": "expand",
    "entryPoints": [
        "./global.d.ts",
        "./*/index.d.ts",
        "./gui/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "cleanOutputDir": true,
    "out": "./docs",
    "validation": {
        "notExported": false
    },
    "plugin": [
        "typedoc-material-theme",
    ],
    "readme": "./docs_readme.md",
    "themeColor": "#ff8200",
}

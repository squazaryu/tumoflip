App(
    appid="renault_seed_bf",
    name="Renault Seed BF",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="renault_seed_bf_app",
    targets=["f7"],
    requires=["gui", "storage", "dialogs"],
    stack_size=4 * 1024,
    fap_category="ARF Tools",
    fap_description="Recover a classic Hitag2 SEED from a saved Renault V1 capture.",
    fap_version="1.0",
    fap_package_only=True,
    fap_dist_path="apps_data/arf_subghz_full/modules/{filename}",
    sources=["renault_seed_bf.c", "hitag2_seed.c"],
)

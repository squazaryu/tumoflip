App(
    appid="arf_subghz_full",
    name="ARF Sub-GHz Full",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="arf_subghz_hub_app",
    sources=["arf_subghz_hub.c"],
    requires=["gui"],
    icon="A_Sub1ghz_14",
    stack_size=2 * 1024,
    fap_icon="icon.png",
    fap_category="ARF Tools",
)

App(
    appid="arf_keeloq",
    name="ARF KeeLoq",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    cdefines=["APP_SUBGHZ", "ARF_PROFILE_KEELOQ"],
    entry_point="subghz_app",
    sources=[
        "subghz.c",
        "subghz_i.c",
        "subghz_last_settings.c",
        "helpers/subghz_txrx.c",
        "helpers/subghz_preset_delta.c",
        "helpers/subghz_threshold_rssi.c",
        "helpers/subghz_keeloq_keys.c",
        "scenes/subghz_scene.c",
        "scenes/subghz_scene_start.c",
        "scenes/subghz_scene_show_error.c",
        "scenes/subghz_scene_show_error_sub.c",
        "scenes/subghz_scene_keeloq_keys.c",
        "scenes/subghz_scene_keeloq_key_edit.c",
        "scenes/subghz_scene_keeloq_bf2.c",
        "scenes/subghz_scene_keeloq_decrypt.c",
        "views/subghz_keeloq_decrypt.c",
    ],
    requires=[
        "gui",
        "dialogs",
        "subghz_radio_broker",
    ],
    icon="A_Sub1ghz_14",
    stack_size=4 * 1024,
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="ARF Tools",
    fap_dist_path="apps_data/arf_subghz_full/modules/{filename}",
)


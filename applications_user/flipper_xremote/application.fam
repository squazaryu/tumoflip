App(
    appid="tumoflip_xremote",
    name="Tumo XRemote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="xremote_main",
    requires=["gui", "dialogs", "infrared", "storage", "subghz_radio_broker"],
    fap_libs=["assets", "infrared"],
    sources=[
        "*.c",
        "!xremote_control.c",
        "!xremote_edit.c",
        "!xremote_general_view.c",
        "!xremote_control_view.c",
        "!xremote_navigation_view.c",
        "!xremote_player_view.c",
        "!xremote_custom_view.c",
        "!xremote_universal_view.c",
    ],
    stack_size=5 * 1024,
    order=1,
    fap_version="1.14.0",
    fap_category="Module One/IR Blaster",
    fap_icon_assets="assets",
    fap_icon_assets_symbol="xc",
    fap_icon="assets/App_Icon_10x10.png",
    fap_author="squazaryu/tumoflip",
    fap_weburl="https://github.com/squazaryu/tumoflip",
    fap_description="Tumo XRemote with IR, AC Smart and an adaptive mixed IR/static Sub-GHz control deck",
)

    fap_category="Module One/NFC",
    fap_dist_path="apps/Module One/NFC/tumocard_os.fap",
    fap_version="0.1.0",
    fap_author="squazaryu/tumoflip",
    fap_weburl="https://github.com/squazaryu/tumoflip/issues/66",
    fap_description="Sandboxed multi-applet NFC and USB CCID runtime powered by TumoVM.",
)

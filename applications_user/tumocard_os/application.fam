App(
    appid="tumocard_os",
    name="TumoCard OS",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="tumocard_os_app",
    requires=["gui", "storage"],
    sources=["*.c", "../tumovm_poc/tumovm_core.c", "../../applications/debug/ccid_test/ccid_usb.c"],
    stack_size=8 * 1024,
    icon="A_Nfc_14",

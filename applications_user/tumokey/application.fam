App(
    appid="tumokey",
    name="TumoKey",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="zerofido_main",
    requires=[
        "gui",
        "storage",
        "notification",
        "nfc",
    ],
    sources=[
        "*.c",
        "!host_tools",
        "!tests",
        "!tools",
        "!*_debug.c",
        "!debug_*.c",
        "!*_diag.c",
        "!diag_*.c",
        "!*_fixture.c",
        "!fixture_*.c",
        "!*_test.c",
        "!test_*.c",
        "!nfc_trace.c",
        "!zerofido_usb_diagnostics.c",
    ],
    cdefines=[
        "ZF_RELEASE_DIAGNOSTICS=0",
        "ZF_USB_DIAGNOSTICS=0",
        "ZF_AUTO_ACCEPT_REQUESTS=0",
        "ZF_DEV_SCREENSHOT=0",
        "ZF_DEV_FIDO2_1=0",
        "ZF_PACKED_ATTESTATION=1",
    ],
    stack_size=4 * 1024,
    icon="A_U2F_14",
    fap_icon="icon.png",
    fap_category="Module One/Security",
    fap_dist_path="apps/Module One/Security/tumokey.fap",
    fap_version="0.9.0",
    fap_author="squazaryu/tumoflip; ZeroFIDO by Alex Stoyanov",
    fap_weburl="https://github.com/squazaryu/tumoflip/issues/173",
    fap_description="Dev-only FIDO2/U2F authenticator with USB HID, NFC, PIN, and resident credentials.",
)

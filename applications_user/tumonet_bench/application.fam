App(
    appid="tumonet_bench",
    name="TumoNet Bench",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="tumonet_bench_app",
    requires=["gui", "storage", "notification", "subghz_radio_broker"],
    sources=["*.c", "!tumonet_core_host.c"],
    stack_size=8 * 1024,
    icon="A_Sub1ghz_14",
    fap_icon="icon.png",
    fap_category="Module One/Sub-GHz",
    fap_dist_path="apps/Module One/Sub-GHz/tumonet_bench.fap",
    fap_version="0.1.0",
    fap_author="squazaryu/tumoflip",
    fap_weburl="https://github.com/squazaryu/tumoflip/issues/86",
    fap_description="Encrypted dual-radio TumoNet bench for internal and external CC1101.",
    fap_libs=["mbedtls"],
)

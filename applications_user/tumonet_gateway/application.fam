App(
    appid="tumonet_gateway",
    name="TumoNet Gateway",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="tumonet_gateway_app",
    requires=["gui", "storage", "bt", "cli", "subghz_radio_broker"],
    sources=["*.c", "!tumonet_gateway_protocol_host.c"],
    stack_size=8 * 1024,
    icon="A_Sub1ghz_14",
    fap_icon="../tumonet_bench/icon.png",
    fap_category="Module One/Network",
    fap_dist_path="apps/Module One/Network/tumonet_gateway.fap",
    fap_version="0.1.0",
    fap_author="squazaryu/tumoflip",
    fap_weburl="https://github.com/squazaryu/tumoflip/issues/70",
    fap_description="BLE, USB and encrypted CC1101 message gateway with a durable inbox.",
    fap_libs=["mbedtls"],
)

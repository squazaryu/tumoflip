    fap_dist_path="apps/Module One/Labs/tumovm_peripherals.fap",
    fap_version="0.1.0",
    fap_author="squazaryu/tumoflip",
    fap_weburl="https://github.com/squazaryu/tumoflip/issues/67",
    fap_description="Bounded SD-defined USB HID and NFC Type 4 peripherals powered by TumoVM.",
)
